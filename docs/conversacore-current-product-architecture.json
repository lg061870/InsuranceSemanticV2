  "cards": [
    {
      "dot": "cyan",
      "title": "Single Runtime Authority",
      "items": [
        "IConversationRuntime coordinates routing, workflow execution, and typed output dispatch",
        "Deterministic ComposedTopicFlow controls execution; models cannot bypass policies or allowlists"
      ]
    },
    {
      "dot": "violet",
      "title": "Authoring & Tool Safety",
      "items": [
        "ComposedTopicFlow composes typed activities post-DI without a runtime JSON interpreter",
        "InvokeToolActivity enforces topic allowlists and derives human confirmation strictly from user choice"
      ]
