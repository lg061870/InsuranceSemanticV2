<UserControl x:Class="ConversaCore.TopicTool.TopicManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid x:Name="RootLayoutGrid" Margin="8">
        <Grid.RowDefinitions>
            <!-- Top action bar -->
            <RowDefinition Height="Auto" />
            <!-- Main split area (dialog definition + topic structure) -->
            <RowDefinition Height="*" />
            <!-- Bottom validation/messages panel -->
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,16,0">
                <Button x:Name="GeneratePlanButton"
                        Content="Generate Plan"
                        Margin="0,0,4,0"
                        Padding="12,4"
                        Click="OnGeneratePlanClicked" />
                <Button x:Name="RefineButton"
                        Content="Refine"
                        Margin="0,0,4,0"
                        Padding="12,4"
                        Click="OnRefineClicked" />
                <Button x:Name="AskAiQuestionsButton"
                        Content="Ask AI Questions"
                        Margin="0,0,4,0"
                        Padding="12,4"
                        Click="OnAskAiQuestionsClicked" />
                <Button x:Name="ValidateButton"
                        Content="Validate"
                        Margin="0,0,4,0"
                        Padding="12,4"
                        Click="OnValidateClicked" />
                <Button x:Name="GenerateCodeButton"
                        Content="Generate Code ⚡"
                        Padding="12,4"
                        Click="OnGenerateCodeClicked" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="ModelComboBox" Width="120" Margin="0,0,8,0">
                    <ComboBoxItem Content="GPT-4o" IsSelected="True" />
                </ComboBox>
                <TextBlock Text="Temperature:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="TemperatureSlider" Minimum="0" Maximum="1" Width="120" Value="0.3" SmallChange="0.1" LargeChange="0.1" />
                <TextBlock x:Name="TemperatureValueTextBlock"
                           Text="0.3"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Main split area -->
        <Grid x:Name="MainSplitGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Dialog Definition (left) -->
            <Border x:Name="DialogPanel" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,4,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="Dialog Definition" FontWeight="Bold" DockPanel.Dock="Left" />
                        <Button x:Name="DialogMaximizeButton"
                                DockPanel.Dock="Right"
                                Width="20"
                                Height="20"
                                Margin="4,0,0,0"
                                Padding="0"
                                ToolTip="Maximize/restore Dialog Definition"
                                Click="OnDialogPanelToggleClicked">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </DockPanel>

                    <StackPanel>
                        <TextBlock Text="Describe the dialog you want the agent to implement." Margin="0,0,0,4" />
                        <TextBox x:Name="DialogDefinitionTextBox"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 MinHeight="160"
                                 Margin="0,0,0,8" />

                        <StackPanel Margin="0,8,0,0">
                            <CheckBox x:Name="StrictConversaCoreModeCheckBox" Content="Strict ConversaCore Mode" Margin="0,0,0,4" />
                            <CheckBox x:Name="AllowApiActivitiesCheckBox" Content="Allow API Activities" Margin="0,0,0,4" />
                            <CheckBox x:Name="AllowAdaptiveCardActivitiesCheckBox" Content="Allow AdaptiveCard Activities" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#404040" />

            <!-- Generated Topic Structure (right) -->
            <Border x:Name="StructurePanel" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="4,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="Generated Topic Structure" FontWeight="Bold" DockPanel.Dock="Left" />
                        <Button x:Name="StructureMaximizeButton"
                                DockPanel.Dock="Right"
                                Width="20"
                                Height="20"
                                Margin="4,0,0,0"
                                Padding="0"
                                ToolTip="Maximize/restore Generated Topic Structure"
                                Click="OnStructurePanelToggleClicked">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- For now a simple placeholder; concrete templates will be added as the design model is wired -->
                        <StackPanel x:Name="TopicsHostPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom validation and messages panel -->
        <Border x:Name="ValidationPanel" Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,8,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Text="Validation &amp; Messages" FontWeight="Bold" DockPanel.Dock="Left" />
                    <Button x:Name="ValidationMaximizeButton"
                            DockPanel.Dock="Right"
                            Width="20"
                            Height="20"
                            Margin="4,0,0,0"
                            Padding="0"
                            ToolTip="Maximize/restore Validation &amp; Messages"
                            Click="OnValidationPanelToggleClicked">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </DockPanel>
                <ListView x:Name="MessagesListView">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Severity}" />
                            <GridViewColumn Header="Message" Width="600" DisplayMemberBinding="{Binding Message}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
