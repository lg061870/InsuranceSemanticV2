@using System.Collections.Generic
@using System.Text.Json
@using ConversaCore.Events
@using ConversaCore.Interfaces
@using ConversaCore.Models
@using ConversaCore.Services
@using ConversaCore.TopicFlow
@using ConversaCore.Agentic
@using ConversaCore.Runtime
@using ConversaCore.UI.Models
@using Microsoft.Extensions.DependencyInjection

@implements IAsyncDisposable

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<CustomChatWindowV3> Logger
@inject IChatInteropService ChatInteropService
@inject IServiceProvider ServiceProvider

<!-- ========== CHAT WINDOW LAYOUT ========== -->
<div class="chat-window-container @GetStyleClass() @(hasStartedConversation ? "conversation-started" : "")">

    @if (Style == ChatStyle.ChatWindow && !hasStartedConversation)
    {
        <!-- ChatWindow: Initial Prompt State -->
        <div class="chat-prompt-initial">
            <img src="@GetAvatarUrl()" 
                 alt="Sofia" 
                 class="prompt-logo" />
            
            <h1 class="prompt-title">Hello, I'm Sofia</h1>
            <p class="prompt-subtitle">Your personal insurance advisor. How can I help you today?</p>
            
            <div class="prompt-input-wrapper">
                <textarea @bind="CurrentMessage"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="Ask me anything about insurance..."
                          class="prompt-input"
                          rows="1"
                          @ref="messageInputRef"></textarea>
                <button class="prompt-send-button"
                        @onclick="SendMessage"
                        disabled="@(IsProcessing || string.IsNullOrWhiteSpace(CurrentMessage))">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>

            <div class="prompt-suggestions">
                <div class="prompt-suggestion-card" @onclick='() => UseSuggestion("first timer v2")'>
                    <div class="suggestion-card-title">Initial Presentation</div>
                    <div class="suggestion-card-description">Start the guided first-time visitor flow</div>
                </div>
                <div class="prompt-suggestion-card" @onclick='() => UseSuggestion("insurance basics")'>
                    <div class="suggestion-card-title">Insurance Basics</div>
                    <div class="suggestion-card-description">I’m new and want the basics explained</div>
                </div>
                <div class="prompt-suggestion-card" @onclick='() => UseSuggestion("Tell me about coverage options")'>
                    <div class="suggestion-card-title">Coverage Options</div>
                    <div class="suggestion-card-description">Explore different types of insurance coverage</div>
                </div>
                <div class="prompt-suggestion-card" @onclick='() => UseSuggestion("test zapier")'>
                    <div class="suggestion-card-title">Test Zapier</div>
                    <div class="suggestion-card-description">Send a test webhook to Zapier</div>
                </div>
                <div class="prompt-suggestion-card" @onclick='() => UseSuggestion("test whatsapp")'>
                    <div class="suggestion-card-title">Test WhatsApp</div>
                    <div class="suggestion-card-description">Send a simple test message via WhatsApp</div>
                </div>
                <div class="prompt-suggestion-card" @onclick='() => UseSuggestion("prompt attention demo")'>
                    <div class="suggestion-card-title">Prompt Attention Demo</div>
                    <div class="suggestion-card-description">Trigger the topic that highlights the chat prompt</div>
                </div>
            </div>
        </div>

        

        <!-- ChatWindow: Full Chat Interface (shown after first message) -->
        <div class="chat-interface">
            @RenderChatContent()
        </div>
    }
    else if (Style == ChatStyle.FloatingChat)
    {
        <!-- FloatingChat: Expanded view -->
        @if (!isMinimized)
        {
            @RenderChatContent()
        }
    }
    else
    {
        <!-- SidebarChat: Default full view -->
        @RenderChatContent()
    }

</div>

@if (Style == ChatStyle.FloatingChat && isMinimized)
{
    <!-- Floating toggle button when minimized -->
    <button class="floating-chat-toggle" @onclick="ToggleMinimize" title="Chat with Sofia">
        <i class="fa-solid fa-comment"></i>
        @if (Messages.Count > 0)
        {
            <span class="notification-badge"></span>
        }
    </button>
}

<!-- Reset Confirmation Dialog -->
@if (showResetConfirmation) {
    <div class="modal-overlay">
        <div class="modal-backdrop" @onclick="HideResetConfirmation"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>Reset Conversation</h3>
                <button class="modal-close" @onclick="HideResetConfirmation">
                    <i class="fa-solid fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to reset the entire conversation?</p>
                <p><strong>This will:</strong></p>
                <ul>
                    <li>Clear all chat history</li>
                    <li>Reset all form data and preferences</li>
                    <li>Start a completely fresh conversation</li>
                </ul>
                <p class="text-warning">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button id="reset-cancel-btn" type="button" class="btn btn-secondary" @onclick="HideResetConfirmation">Cancel</button>
                <button id="reset-confirm-btn" type="button" class="btn btn-danger" @onclick="ExecuteReset">Reset Conversation</button>
            </div>
        </div>
    </div>
}



@code {
    // ========== PARAMETERS ========== 
    /// <summary>The preferred framework-owned runtime. When omitted, the scoped DI registration is used.</summary>
    [Parameter] public IConversationRuntime? Runtime { get; set; }

    /// <summary>Temporary compatibility fallback for applications not yet migrated to IConversationRuntime.</summary>
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    [Parameter] public DomainAgentService? AgentService { get; set; }
    
    /// <summary>
    /// The visual style of the chat interface (SidebarChat, FloatingChat, or ChatWindow).
    /// </summary>
    [Parameter] public ChatStyle Style { get; set; } = ChatStyle.SidebarChat;
    
    // Allow consumer to provide a subscribe method via parameter
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    [Parameter] public Action<CustomChatWindowV3>? SubscribeToEvents { get; set; }

    // ========== STATE ========== 
    private readonly ConversationOutputViewState _outputState = new();
    private List<ChatMessage> Messages => _outputState.Messages;
    private string _currentMessage = "";
    private string CurrentMessage 
    { 
        get => _currentMessage;
        set
        {
            _currentMessage = value;
        }
    }
    private bool IsTyping { get; set; } = false;
    private bool IsProcessing { get; set; } = false;
    private ChatMessage? messageBeingEdited = null;
    private bool _conversationStarted = false;
    private bool showResetConfirmation = false;
    private bool IsPromptEnabled => _outputState.IsPromptEnabled;
    private bool isMinimized = true; // Start minimized for FloatingChat (icon mode)
    private bool hasStartedConversation = false; // For ChatWindow style

    // Transient prompt attention state driven by chat interaction events
    private bool IsPromptAttentionActive { get; set; } = false;
    private string? PromptAttentionText { get; set; }

    private ElementReference messagesContainerRef;
    private ElementReference messageInputRef;

    private List<string> CurrentSuggestions { get; set; } = new();
    private IConversationRuntime? _activeRuntime;
    private IConversationOutputSubscription? _outputSubscription;
    private CancellationTokenSource? _outputCancellation;
    private Task? _outputPump;

    private DomainAgentService? LegacyAgentService => AgentService;
    private Action<CustomChatWindowV3>? LegacySubscribeToEvents => SubscribeToEvents;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        
        // Initialize minimization state based on style
        if (Style != ChatStyle.FloatingChat)
        {
            isMinimized = false; // Start expanded for sidebar and chat window styles
        }
        // FloatingChat starts minimized (as icon)
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender && !_conversationStarted) {
            _activeRuntime = Runtime ?? ServiceProvider.GetService<IConversationRuntime>();
            if (_activeRuntime is not null) {
                await InitializeRuntimeAsync(_activeRuntime);
                _conversationStarted = true;
                return;
            }

            var legacyAgent = LegacyAgentService;
            if (legacyAgent is null) {
                Logger.LogError(
                    "[ChatWindowV3] No IConversationRuntime registration or legacy AgentService was supplied");
                Messages.Add(new ChatMessage {
                    Content = "⚠️ The conversation runtime is not configured.",
                    IsFromUser = false,
                    Timestamp = DateTime.Now
                });
                _conversationStarted = true;
                StateHasChanged();
                return;
            }

            try {
                Logger?.LogInformation("[ChatWindowV3] 🔄 First render - initializing event-driven architecture");

            // ========== SUBSCRIBE AGENT TO UI EVENTS ==========
            Logger?.LogInformation("[ChatWindowV3] Wiring agent event subscriptions");

            // Call the consumer-provided subscription method if available
            LegacySubscribeToEvents?.Invoke(this);

            // ========== SUBSCRIBE UI TO AGENT EVENTS ==========
            Logger?.LogInformation("[ChatWindowV3] Subscribing to agent outbound events");

            // Bot messages
            legacyAgent.ActivityMessageReady += (s, e) => {
                Logger?.LogInformation("[ChatWindowV3] ActivityMessageReady: {Content}", e.Message.Content);

                _ = InvokeAsync(() => {
                    // Clear typing/busy indicators when a bot message arrives
                    IsTyping = false;
                    IsProcessing = false;
                    Messages.Add(e.Message);
                    StateHasChanged();
                });
            };

            // Adaptive cards
            legacyAgent.ActivityAdaptiveCardReady += (s, e) => {
                Logger?.LogInformation(
                    "[ChatWindowV3] ActivityAdaptiveCardReady: CardId={CardId}, RenderMode={RenderMode}",
                    e.CardId,
                    e.RenderMode
                );

                _ = InvokeAsync(() => {
                    // Clear typing/busy indicators when a card is ready
                    IsTyping = false;
                    IsProcessing = false;
                    if (e.RenderMode == ConversaCore.Events.RenderMode.Replace &&
                        !string.IsNullOrEmpty(e.CardId)) {
                        var existing = Messages.FirstOrDefault(m =>
                            m.IsAdaptiveCard && m.CardId == e.CardId);

                        if (existing != null) {
                            existing.AdaptiveCardJson = e.CardJson;
                            existing.Timestamp = DateTime.Now;
                            StateHasChanged();

                            Logger?.LogInformation(
                                "[ChatWindowV3] AdaptiveCard replaced: CardId={CardId}",
                                e.CardId
                            );
                            return;
                        }
                    }

                    // Append new card
                    Messages.Add(new ChatMessage {
                        IsFromUser = false,
                        IsAdaptiveCard = true,
                        AdaptiveCardJson = e.CardJson,
                        CardId = e.CardId,
                        Timestamp = DateTime.Now
                    });

                    StateHasChanged();

                    Logger?.LogInformation(
                        "[ChatWindowV3] AdaptiveCard appended: CardId={CardId}",
                        e.CardId
                    );
                });
            };

            // Card state changes
            legacyAgent.CardStateChanged += (s, e) => {
                Logger?.LogInformation(
                    "[ChatWindowV3] Card state changed: {CardId} -> {State}",
                    e.CardId,
                    e.State
                );

                _ = InvokeAsync(async () => {
                    var index = Messages.FindIndex(m =>
                        m.IsAdaptiveCard && m.CardId == e.CardId);

                    if (index != -1) {
                        var card = Messages[index];
                        bool newIsActive = e.State == CardState.Active;

                        if (card.IsActive != newIsActive) {
                            Logger?.LogInformation(
                                "[ChatWindowV3] Updating card {CardId} active={IsActive}",
                                e.CardId,
                                newIsActive
                            );

                            card.IsActive = newIsActive;
                            Messages[index] = card;
                            StateHasChanged();

                            if (newIsActive) {
                                Logger?.LogInformation(
                                    "[ChatWindowV3] Scrolling to bottom after activating {CardId}",
                                    e.CardId
                                );

                                await ChatInteropService
                                    .ScrollToBottomAsync(messagesContainerRef);
                            }
                        }
                    }
                });
            };

            // Prompt state
            legacyAgent.PromptInputStateChanged += (s, e) => {
                Logger?.LogInformation(
                    "[ChatWindowV3] Prompt state changed: Enabled={IsEnabled} (CardId={CardId})",
                    e.IsEnabled,
                    e.CardId
                );

                _ = InvokeAsync(() => {
                    _outputState.SetPromptEnabled(e.IsEnabled);
                    StateHasChanged();
                });
            };

            // Custom events (e.g., suggestion chips)
            legacyAgent.CustomEventTriggered += (s, e) => {
                Logger?.LogInformation("[ChatWindowV3] CustomEventTriggered: {EventName}", e.EventName);

                if (e.EventName == "UpdateSuggestions")
                {
                    _ = InvokeAsync(() => {
                        if (e.EventData is IEnumerable<string> list)
                        {
                            CurrentSuggestions = list.ToList();
                            StateHasChanged();
                        }
                    });
                }
                else if (e.EventName == "PromptAttention")
                {
                    _ = InvokeAsync(async () => {
                        try
                        {
                            // Expect a ChatInteractionPayload when sent from TopicFlowActivity
                            if (e.EventData is ChatInteractionPayload payload)
                            {
                                PromptAttentionText = payload.Message ?? "Your input is required";
                                IsPromptAttentionActive = true;
                                StateHasChanged();

                                if (payload.DurationMs.HasValue && payload.DurationMs.Value > 0)
                                {
                                    try
                                    {
                                        await Task.Delay(payload.DurationMs.Value);
                                    }
                                    catch { /* ignore cancellation */ }

                                    IsPromptAttentionActive = false;
                                    StateHasChanged();
                                }
                            }
                            else
                            {
                                PromptAttentionText = "Your input is required";
                                IsPromptAttentionActive = true;
                                StateHasChanged();
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger?.LogError(ex, "[ChatWindowV3] Error handling PromptAttention event");
                        }
                    });
                }
            };

            // Conversation reset
            legacyAgent.ConversationReset += (s, e) => {
                Logger?.LogInformation(
                    "[ChatWindowV3] ConversationReset at {ResetTime}",
                    e.ResetTime
                );

                Logger?.LogInformation(
                    "[ChatWindowV3] Clearing {Count} messages",
                    Messages.Count
                );

                _ = InvokeAsync(() => {
                    _outputState.Clear();
                    // For ChatWindow style, return to initial prompt mode
                    if (Style == ChatStyle.ChatWindow)
                    {
                        hasStartedConversation = false;
                        CurrentMessage = string.Empty;
                    }
                    StateHasChanged();
                    Logger?.LogInformation("[ChatWindowV3] Messages cleared");
                });
            };

            // Lifecycle logging
            legacyAgent.ActivityCompleted += (s, e) =>
                Logger?.LogDebug("[ChatWindowV3] ActivityCompleted");

            legacyAgent.TopicLifecycleChanged += (s, e) =>
                Logger?.LogDebug(
                    "[ChatWindowV3] TopicLifecycleChanged: {TopicName} -> {State}",
                    e.TopicName,
                    e.State
                );

            legacyAgent.ActivityLifecycleChanged += (s, e) =>
                Logger?.LogDebug(
                    "[ChatWindowV3] ActivityLifecycleChanged: {ActivityId} -> {State}",
                    e.ActivityId,
                    e.State
                );

            // ========== START CONVERSATION ==========
            Logger?.LogInformation(
                "[ChatWindowV3] Raising ConversationStartRequested event"
            );

            ConversationStartRequested?.Invoke(
                this,
                new ConversationStartRequestedEventArgs(CancellationToken.None)
            );

            _conversationStarted = true;

                Logger?.LogInformation(
                    "[ChatWindowV3] ✅ Event-driven initialization complete"
                );
            } catch (Exception ex) {
                Logger?.LogError(ex, "[ChatWindowV3] OnAfterRender initialization error: {Message}", ex.Message);
            }
        }
    }

    private async Task InitializeRuntimeAsync(IConversationRuntime runtime) {
        try {
            Logger.LogInformation("[ChatWindowV3] Binding directly to conversation runtime {ConversationId}",
                runtime.ConversationId);
            _outputCancellation = new CancellationTokenSource();
            _outputSubscription = runtime.Subscribe();
            _outputPump = ConsumeRuntimeOutputAsync(_outputSubscription, _outputCancellation.Token);
            await runtime.StartAsync(_outputCancellation.Token);
        } catch (Exception ex) {
            Logger.LogError(ex, "[ChatWindowV3] Runtime initialization failed");
            Messages.Add(new ChatMessage {
                Content = "⚠️ The conversation could not be started. Please try again.",
                IsFromUser = false,
                Timestamp = DateTime.Now
            });
            StateHasChanged();
        }
    }

    private async Task ConsumeRuntimeOutputAsync(
        IConversationOutputSubscription subscription,
        CancellationToken cancellationToken) {
        try {
            await foreach (var output in subscription.ReadAllAsync(cancellationToken)) {
                await InvokeAsync(async () => {
                    var change = _outputState.Apply(output);
                    if (change.ClearBusyIndicator) {
                        IsTyping = false;
                        IsProcessing = false;
                    }
                    if (change.StateChanged) StateHasChanged();
                    if (change.ScrollToBottom)
                        await ChatInteropService.ScrollToBottomAsync(messagesContainerRef);
                });
            }
        } catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
            Logger.LogDebug("[ChatWindowV3] Runtime output subscription cancelled");
        } catch (Exception ex) {
            Logger.LogError(ex, "[ChatWindowV3] Runtime output subscription failed");
        }
    }

    private string GetAvatarUrl()
    {
        // Prefer external CDN if reachable; fallback to embedded RCL asset
        // Use the well-known static web assets path used by Blazor RCLs
        return NavigationManager.BaseUri.TrimEnd('/') + "/_content/ConversaCore.UI/avatars/avatar-ai-1.svg";
    }


    public async ValueTask DisposeAsync() {
        try {
            Logger.LogInformation("[ChatWindowV3] Disposing conversation output subscription");
            _outputCancellation?.Cancel();
            if (_outputSubscription is not null)
                await _outputSubscription.DisposeAsync();
            if (_outputPump is not null)
                await _outputPump;
            _outputCancellation?.Dispose();
        } catch (Exception ex) {
            Logger.LogError(ex, "[ChatWindowV3] Dispose error: {Message}", ex.Message);
        }
    }
    

    // ========== CONVERSATION ========== 
    private async Task SendMessage() {
        if (string.IsNullOrWhiteSpace(CurrentMessage) || IsProcessing)
            return;

        Logger?.LogInformation("[ChatWindowV3] SendMessage: {Message}", CurrentMessage);
        IsProcessing = true;

        // Mark conversation as started for ChatWindow style
        if (Style == ChatStyle.ChatWindow && !hasStartedConversation)
        {
            hasStartedConversation = true;
            Logger?.LogInformation("[ChatWindowV3] First message sent - transitioning to full chat interface");
        }

        var userMessage = new ChatMessage {
            Content = CurrentMessage,
            IsFromUser = true,
            Timestamp = DateTime.Now
        };

        Messages.Add(userMessage);

        // Show typing indicator while waiting for the agent response
        IsTyping = true;

        string userMessageText = CurrentMessage;
        CurrentMessage = "";
        StateHasChanged();
        await ChatInteropService.ScrollToBottomAsync(messagesContainerRef);

        try {
            if (_activeRuntime is not null) {
                Logger?.LogInformation("[ChatWindowV3] Sending message through IConversationRuntime");
                await _activeRuntime.SendMessageAsync(userMessageText);
            } else {
                Logger?.LogInformation("[ChatWindowV3] Raising legacy UserMessageReceived event");
                UserMessageReceived?.Invoke(this, new UserMessageReceivedEventArgs(userMessageText, CancellationToken.None));
            }
        } catch (Exception ex) {
            Logger?.LogError(ex, "[ChatWindowV3] Error processing message");
            Messages.Add(new ChatMessage {
                Content = "⚠️ An error occurred. Please try again.",
                IsFromUser = false,
                Timestamp = DateTime.Now
            });
            StateHasChanged();
        } finally {
            if (_activeRuntime is not null) {
                IsProcessing = false;
                IsTyping = false;
                StateHasChanged();
            }
            Logger?.LogInformation("[ChatWindowV3] SendMessage completed");
        }
    }

    // ========== UTILITY ========== 
    private void ClearChat() {
        Logger?.LogInformation("[ChatWindowV3] ClearChat: clearing {Count} messages", Messages.Count);
        _outputState.Clear();
        StateHasChanged();
    }

    private void ConfirmReset() {
        Logger?.LogInformation("[ChatWindowV3] ConfirmReset: showing confirmation dialog");
        showResetConfirmation = true;
        StateHasChanged();
    }

    private void HideResetConfirmation() {
        Logger?.LogInformation("[ChatWindowV3] HideResetConfirmation: hiding dialog");
        showResetConfirmation = false;
        StateHasChanged();
    }

    private async Task ExecuteReset() {
        Logger?.LogInformation("[ChatWindowV3] ExecuteReset: starting reset");
        showResetConfirmation = false;
        StateHasChanged();

        try {
            _outputState.Clear();
            StateHasChanged();
            await Task.Delay(100);

            if (_activeRuntime is not null)
                await _activeRuntime.ResetAsync();
            else
                ConversationResetRequested?.Invoke(this, new ConversationResetRequestedEventArgs(CancellationToken.None));

            Logger?.LogInformation("[ChatWindowV3] Reset completed");

            StateHasChanged();
        } catch (Exception ex) {
            Logger?.LogError(ex, "[ChatWindowV3] Error resetting conversation");
            Messages.Add(new ChatMessage {
                Content = "⚠️ There was an error resetting the conversation. Please try again.",
                IsFromUser = false,
                Timestamp = DateTime.Now
            });
            StateHasChanged();
        }
    }

    private async Task CopyMessageToClipboard(ChatMessage message) {
        if (message == null || string.IsNullOrEmpty(message.Content)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", message.Content);
        Logger?.LogInformation("[ChatWindowV3] Message copied to clipboard");
    }

    private void EditMessage(ChatMessage message) {
        if (message == null) return;
        messageBeingEdited = message;
        CurrentMessage = message.Content;
        StateHasChanged();
    }

    private string FormatMessageContent(string content) =>
        string.IsNullOrEmpty(content) ? string.Empty : content;

    private Task HandleCardAction(string actionId) {
        Logger?.LogInformation("[ChatWindowV3] HandleCardAction: {ActionId}", actionId);
        return Task.CompletedTask;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter" && !e.ShiftKey) {
            await SendMessage();
        }
    }

    private async Task UseSuggestion(string suggestion) {
        Logger?.LogInformation("[ChatWindowV3] UseSuggestion: {Suggestion}", suggestion);
        CurrentMessage = suggestion;
        await SendMessage();
    }

    private async Task UseOption(ChatMessage originatingMessage, string option) {
        if (string.IsNullOrWhiteSpace(option)) return;

        Logger?.LogInformation("[ChatWindowV3] UseOption: {Option}", option);

        // Add a user message for the selected option
        var userMessage = new ChatMessage {
            Content = option,
            IsFromUser = true,
            Timestamp = DateTime.Now
        };

        Messages.Add(userMessage);

        // Optionally mark originating message as no longer active
        originatingMessage.IsActive = false;

        StateHasChanged();
        await ChatInteropService.ScrollToBottomAsync(messagesContainerRef);

        // Raise user message event so the conversation engine receives the choice
        if (_activeRuntime is not null)
            await _activeRuntime.SendMessageAsync(option);
        else
            UserMessageReceived?.Invoke(this, new UserMessageReceivedEventArgs(option, CancellationToken.None));
    }

    private async Task OnAdaptiveCardSubmit(string? cardId, Dictionary<string, object> data) {
        Logger?.LogInformation("[ChatWindowV3] OnAdaptiveCardSubmit: {Keys}", string.Join(",", data.Keys));
        Logger?.LogInformation("[ChatWindowV3] Raising CardSubmitted event");
        // Show typing/busy indicator while the back-end processes the card
        IsProcessing = true;
        IsTyping = true;
        StateHasChanged();
        try {
            if (_activeRuntime is not null) {
                if (string.IsNullOrWhiteSpace(cardId))
                    throw new InvalidOperationException("The submitted adaptive card has no runtime card identifier.");
                await _activeRuntime.SubmitCardAsync(new CardSubmission(cardId, data));
            } else {
                CardSubmitted?.Invoke(this, new CardSubmittedEventArgs(data, CancellationToken.None));
            }
        } catch (Exception ex) {
            Logger?.LogError(ex, "[ChatWindowV3] Error processing adaptive-card submission");
            Messages.Add(new ChatMessage {
                Content = "⚠️ The form could not be submitted. Please try again.",
                IsFromUser = false,
                Timestamp = DateTime.Now
            });
            StateHasChanged();
        } finally {
            if (_activeRuntime is not null) {
                IsProcessing = false;
                IsTyping = false;
                StateHasChanged();
            }
        }
    }

    // ========== PUBLIC METHODS ==========
    /// <summary>
    /// Programmatically triggers a conversation reset by invoking ExecuteReset
    /// </summary>
    public Task RequestReset()
    {
        Logger?.LogInformation("[ChatWindowV3] RequestReset: externally triggered");
        return ExecuteReset();
    }

    // ========== PUBLIC EVENTS (UI → Agent) ==========
    public event EventHandler<UserMessageReceivedEventArgs>? UserMessageReceived;
    public event EventHandler<ConversationStartRequestedEventArgs>? ConversationStartRequested;
    public event EventHandler<ConversationResetRequestedEventArgs>? ConversationResetRequested;
    public event EventHandler<CardSubmittedEventArgs>? CardSubmitted;

    // ========== HELPER METHODS ==========
    private string GetStyleClass() => Style switch
    {
        ChatStyle.FloatingChat => "style-floating" + (isMinimized ? " minimized" : ""),
        ChatStyle.ChatWindow => "style-chatwindow",
        _ => "style-sidebar"
    };

    private void ToggleMinimize()
    {
        isMinimized = !isMinimized;
        Logger?.LogInformation("[ChatWindowV3] Toggled minimize: {IsMinimized}", isMinimized);
        StateHasChanged();
    }

    private RenderFragment RenderChatContent() => __builder =>
    {
        // Header
        <div class="chat-header">
            <div class="chat-header-avatar">
                <div class="avatar-circle">
                    <img src="@GetAvatarUrl()" alt="Sofia" />
                    <div class="avatar-status"></div>
                </div>
            </div>
            <div class="chat-header-info">
                <h3 class="chat-header-name">Sofia</h3>
                <div class="chat-header-status">
                    <div class="status-indicator"></div>
                    <span>V3 -- Direct Agent • Online</span>
                </div>
            </div>
            <div class="chat-header-actions">
                @if (Style == ChatStyle.FloatingChat)
                {
                    <button class="minimize-button" title="Minimize" @onclick="ToggleMinimize">
                        <i class="fa-solid fa-minus"></i>
                    </button>
                }
                <button class="chat-header-button" title="Reset conversation" @onclick="ExecuteReset">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <button class="chat-header-button" title="Clear chat" @onclick="ClearChat">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </div>
        </div>

        // Message history
        <div class="messages-container" @ref="messagesContainerRef">
            @foreach (var message in Messages)
            {
                @if (message.IsFromUser)
                {
                    <!-- User messages -->
                    <div class="message-group">
                        <div class="message user-message">
                            <div class="message-content">@message.Content</div>
                            <div class="message-time">@message.Timestamp.ToString("h:mm tt")</div>
                            <div class="message-actions">
                                <button class="message-action-button" title="Edit" @onclick="() => EditMessage(message)">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Bot messages -->
                    <div class="message-group">
                        <div class="message bot-message">

                            @if (message.IsAdaptiveCard && !string.IsNullOrEmpty(message.AdaptiveCardJson))
                            {
                                <!-- Adaptive Card -->
                                <div class="adaptive-card-container @(message.IsActive ? "" : "readonly")">
                                    <AdaptiveCardRenderer CardJson="@message.AdaptiveCardJson"
                                                          CardContainerId="@($"card-{message.Timestamp.Ticks}")"
                                                          Disabled="@(!message.IsActive)"
                                                          OnSubmit="@(data => OnAdaptiveCardSubmit(message.CardId, data))"
                                                          OnAction="HandleCardAction" />

                                </div>

                                <div class="message-time">@message.Timestamp.ToString("h:mm tt")</div>
                            }
                            else
                            {
                                <!-- Plain text message -->
                                <div class="message-content">@((MarkupString)FormatMessageContent(message.Content))</div>
                                @if (message.Options != null && message.Options.Count > 0)
                                {
                                    <div class="message-options">
                                        @foreach (var opt in message.Options)
                                        {
                                            <button class="option-button" @onclick="() => UseOption(message, opt)">@opt</button>
                                        }
                                    </div>
                                }
                                <div class="message-time">@message.Timestamp.ToString("h:mm tt")</div>
                                <div class="message-actions">
                                    <button class="message-action-button" title="Copy" @onclick="() => CopyMessageToClipboard(message)">
                                        <i class="fa-solid fa-copy"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            <!-- Typing indicator -->
            @if (IsTyping)
            {
                <div class="message bot-message typing-indicator">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            }
        </div>

        // Suggestion chips
        @if (Style != ChatStyle.ChatWindow)
        {
            <div class="chat-suggestions @(!IsPromptEnabled ? "disabled" : "")">
                @foreach (var suggestion in CurrentSuggestions)
                {
                    <div class="suggestion-chip"
                         @onclick="() => UseSuggestion(suggestion)"
                         disabled="@(!IsPromptEnabled)">
                        @suggestion
                    </div>
                }
            </div>
        }

        // Message input
        <div class="message-input-container @(IsPromptAttentionActive ? "prompt-attention" : "")" title="@(!IsPromptEnabled ? "Please complete the required card above before continuing." : null)">
            @if (IsPromptAttentionActive && !string.IsNullOrEmpty(PromptAttentionText))
            {
                <div class="prompt-attention-label">@PromptAttentionText</div>
            }
            <div class="message-input-row">
                <div class="message-input-field">
                    <textarea @bind="CurrentMessage"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              placeholder="@(!IsPromptEnabled
                                                  ? "Please complete the required card above before continuing..."
                                                  : "Type your message...")"
                              disabled="@(!IsPromptEnabled || IsProcessing)"
                              class="message-input @(!IsPromptEnabled ? "disabled" : "") @(IsPromptAttentionActive ? "attention-active" : "")"
                              rows="1"
                              @ref="messageInputRef"></textarea>
                </div>

                <button class="send-button"
                        @onclick="SendMessage"
                        disabled="@(!IsPromptEnabled || IsProcessing || string.IsNullOrWhiteSpace(CurrentMessage))">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
        </div>
        
    };
}
