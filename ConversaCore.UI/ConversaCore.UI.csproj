<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConversaCore\ConversaCore.csproj" />
  </ItemGroup>

  <Target Name="CopyToBlazorTemplateHostLib" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_TemplateHostLibDir>$(MSBuildThisFileDirectory)..\ConversaCore.SDK\ConversaCore.BlazorTemplateHost\lib\</_TemplateHostLibDir>
    </PropertyGroup>

    <Message Importance="High" Text="Copying ConversaCore.UI build output to '$(_TemplateHostLibDir)'" />
    <MakeDir Directories="$(_TemplateHostLibDir)" Condition="!Exists('$(_TemplateHostLibDir)')" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(_TemplateHostLibDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
