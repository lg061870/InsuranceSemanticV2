<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>ConversaCore.UI</PackageId>
    <Version>1.0.0</Version>
    <Authors>ConversaCore</Authors>
    <Company>ConversaCore</Company>
    <Description>ConversaCore Blazor chat, adaptive card, and presentation components.</Description>
    <PackageTags>conversational-ai;blazor;ui;adaptive-cards</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConversaCore\ConversaCore.csproj" />
  </ItemGroup>

</Project>
