{
  "$schema": "http://json.schemastore.org/template",
  "author": "ConversaCore",
  "classifications": [ "Web", "Blazor", "ConversaCore" ],
  "identity": "ConversaCore.BlazorTemplateHost.Template",
  "name": "ConversaCore Blazor Template Host",
  "shortName": "conversacore-blazor",
  "sourceName": "ConversaCore.BlazorTemplateHost",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "usePackages": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Configure the project to consume ConversaCore NuGet packages directly."
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "Directory.Build.props",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**",
        "**/*.user",
        "**/*.suo",
        "**/*.cache",
        "**/*.db",
        "**/*.nupkg",
        "**/*.snupkg",
        "**/.template.config/**",
        "**/logs/**",
        "**/node_modules/**",
        "**/*.sln",
        "**/*.vstemplate",
        "**/*.ps1",
        "templates/**",
        "artifacts/**"
      ]
    }
  ]
}
