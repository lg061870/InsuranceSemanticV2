<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <AspNetCoreModuleStdoutLogEnabled>true</AspNetCoreModuleStdoutLogEnabled>
    <AspNetCoreModuleStdoutLogFile>.\logs\stdout</AspNetCoreModuleStdoutLogFile>
    <!--#if (usePackages)-->
    <ConversaCoreUsePackages>true</ConversaCoreUsePackages>
    <!--#endif-->
  </PropertyGroup>

  <!--#if (false)-->
  <!-- TEMPLATE SOURCE ONLY: This section is excluded from generated projects -->
  <ItemGroup>
    <Content Include="templates\conversacore-blazor\.template.config\template.json" />
  </ItemGroup>
  <!--#endif-->

  <!-- Repository builds use source projects; template consumers use ConversaCore NuGet packages -->
  <ItemGroup Condition="'$(ConversaCoreDev)' == 'true'">
    <ProjectReference Include="..\..\ConversaCore\ConversaCore.csproj" />
    <ProjectReference Include="..\..\ConversaCore.UI\ConversaCore.UI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ConversaCoreDev)' != 'true'">
    <PackageReference Include="ConversaCore" Version="1.0.0" />
    <PackageReference Include="ConversaCore.UI" Version="1.0.0" />
  </ItemGroup>

  <!-- Add required NuGet packages that ConversaCore depends on -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory" Version="1.71.0-preview" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.SqliteVec" Version="1.71.0-preview" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Chroma" Version="1.71.0-alpha" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.71.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.2.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
  </ItemGroup>

</Project>
